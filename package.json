{
  "name": "@ramon-sg/issue-flow",
  "version": "0.5.1",
  "description": "Issue-to-PR workflow for any repo: names each issue's branch, creates its worktree, opens the draft PR and launches Claude Code, locally and in Claude's cloud.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "issue-flow": "bundle/cli.js"
  },
  "files": [
    "bundle",
    "schema.json",
    "recipes"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramon-sg/issue-flow.git"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=bundle/cli.js",
    "test": "tsc && npm run bundle && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@ramon-sg/github-rest": "0.6.0",
    "@ramon-sg/runner": "1.0.0",
    "@ramon-sg/skills-manager": "1.2.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  }
}
